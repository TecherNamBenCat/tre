#!/bin/bash
# =============================================================
#  Tre — đảm bảo máy đã cài luôn có tài khoản giáo viên
#      tên: giaovien      mật khẩu ban đầu: giaovien
#  Chạy mỗi lần khởi động (trước màn hình đăng nhập) và khi cập nhật.
#  Không làm gì trong bản Live. Đổi mật khẩu: sudo tre-quan-ly doi-mat-khau
# =============================================================
set -euo pipefail
[[ -d /run/live ]] && exit 0

if ! id giaovien >/dev/null 2>&1; then
    # UID 1000 nếu còn trống (tài khoản người dùng đầu tiên của máy)
    if getent passwd 1000 >/dev/null; then
        useradd --create-home --shell /bin/bash --comment "Giáo viên" giaovien
    else
        useradd --uid 1000 --create-home --shell /bin/bash --comment "Giáo viên" giaovien
    fi
    echo 'giaovien:giaovien' | chpasswd
    echo "Tre: đã tạo tài khoản giáo viên 'giaovien' (mật khẩu ban đầu: giaovien)."
fi
for g in sudo adm audio video plugdev netdev users lpadmin autologin; do
    getent group "$g" >/dev/null && usermod -aG "$g" giaovien || true
done
/usr/share/tre/ap-dung-tu-dang-nhap
