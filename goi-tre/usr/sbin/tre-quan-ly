#!/bin/bash
# =============================================================
#  Tre — Lệnh quản lý dành cho giáo viên
#  Dùng:  sudo tre-quan-ly <lệnh>
# =============================================================
set -euo pipefail

TEN_HS="${TRE_TEN_HS:-hocsinh}"
NHA_HS="${TRE_NHA_HS:-/home/$TEN_HS}"
MAU="${TRE_MAU:-/var/lib/tre/hocsinh-mau}"
TAT="${TRE_CO_TAT:-/etc/tre/tat-khoi-phuc}"
TAT_TU_DANG_NHAP=/etc/tre/tat-tu-dang-nhap
GIU_LAI="LuuBai"

huong_dan() {
    cat <<'HD'
Cách dùng:  sudo tre-quan-ly <lệnh>

  tao-hocsinh        Tạo tài khoản học sinh "hocsinh" (không mật khẩu, không quyền quản trị,
                     tự khôi phục mỗi lần khởi động). Tạo xong máy tự vào tài khoản này.
  xoa-hocsinh        Xoá tài khoản học sinh (máy quay lại tự vào tài khoản giáo viên)
  doi-mat-khau       Đổi mật khẩu tài khoản giáo viên

  man-hinh-dong bat  Bật màn hình động khi bật/tắt máy (chỉ nên bật trên máy thật)
  man-hinh-dong tat  Tắt màn hình động

  phien-ban          Xem phiên bản Tre đang chạy
  cap-nhat           Cập nhật Tre NGAY (bình thường máy tự cập nhật mỗi ngày)

  trang-thai         Xem chế độ khôi phục tài khoản học sinh đang bật hay tắt
  tat                Tạm TẮT khôi phục (để chỉnh tài khoản học sinh)
  bat                BẬT lại khôi phục khi khởi động
  luu-mau            Lấy tài khoản học sinh hiện tại làm bản mẫu mới
  xoa-bai            Xoá sạch thư mục LuuBai của học sinh (đầu học kỳ mới)

  tu-dang-nhap bat   Bật máy là tự vào tài khoản học sinh (mặc định)
  tu-dang-nhap tat   Bật máy thì hiện màn hình chọn tài khoản

Quy trình chỉnh bản mẫu cho học sinh:
  1) sudo tre-quan-ly tat   2) khởi động lại, ở tài khoản hocsinh chỉnh sửa
  3) đăng xuất, vào tài khoản giáo viên: sudo tre-quan-ly luu-mau
  4) sudo tre-quan-ly bat
HD
}

if [[ "${1:-}" == "phien-ban" ]]; then
    dpkg-query -W -f='Tre ${Version}\n' tre-he-thong 2>/dev/null || echo "Chưa cài gói tre-he-thong"
    exit 0
fi

if [[ $EUID -ne 0 ]]; then
    echo "Cần quyền quản trị:  sudo tre-quan-ly ${1:-}"
    exit 1
fi

case "${1:-}" in
    tao-hocsinh)
        if id "$TEN_HS" >/dev/null 2>&1; then
            echo "Đã có tài khoản $TEN_HS rồi."
        else
            if getent passwd 1500 >/dev/null; then
                useradd --create-home --shell /bin/bash --comment "Học sinh" "$TEN_HS"
            else
                useradd --uid 1500 --create-home --shell /bin/bash --comment "Học sinh" "$TEN_HS"
            fi
            echo "Đã tạo tài khoản $TEN_HS."
        fi
        passwd -d "$TEN_HS" >/dev/null
        for g in audio video plugdev netdev users autologin nopasswdlogin; do
            getent group "$g" >/dev/null && usermod -aG "$g" "$TEN_HS" || true
        done
        gpasswd -d "$TEN_HS" sudo >/dev/null 2>&1 || true
        rm -rf "$MAU"                      # bản mẫu tạo lại từ đầu
        /usr/sbin/tre-khoi-phuc-hocsinh
        /usr/share/tre/ap-dung-tu-dang-nhap
        echo "Xong. Từ lần khởi động sau, máy tự vào tài khoản học sinh (không mật khẩu)."
        echo "Giáo viên vào lại tài khoản của mình: Đăng xuất -> chọn Giáo viên."
        ;;
    xoa-hocsinh)
        if ! id "$TEN_HS" >/dev/null 2>&1; then echo "Chưa có tài khoản $TEN_HS."; exit 0; fi
        read -r -p "Xoá tài khoản $TEN_HS và TOÀN BỘ bài trong LuuBai? (c/k) " tl
        if [[ "$tl" == "c" ]]; then
            userdel -r "$TEN_HS" 2>/dev/null || userdel "$TEN_HS"
            rm -rf "$MAU"
            /usr/share/tre/ap-dung-tu-dang-nhap
            echo "Đã xoá. Máy sẽ tự vào tài khoản giáo viên."
        fi
        ;;
    man-hinh-dong)
        G=/etc/default/grub
        [[ -f "$G" ]] || { echo "Không thấy $G"; exit 1; }
        case "${2:-}" in
            bat) apt-get install -y plymouth
                 plymouth-set-default-theme tre
                 update-initramfs -u
                 grep -q '^GRUB_CMDLINE_LINUX_DEFAULT=.*splash' "$G" || \
                 sed -i 's/^GRUB_CMDLINE_LINUX_DEFAULT="\(.*\)"/GRUB_CMDLINE_LINUX_DEFAULT="\1 splash"/' "$G" ;;
            tat) sed -i '/^GRUB_CMDLINE_LINUX_DEFAULT=/ s/ *splash//' "$G" ;;
            *)   echo "Dùng: sudo tre-quan-ly man-hinh-dong bat|tat"; exit 1 ;;
        esac
        update-grub
        echo "Xong. Có hiệu lực từ lần khởi động sau."
        ;;
    doi-mat-khau)
        passwd giaovien
        ;;
    cap-nhat)
        echo ">> Đang tải danh sách cập nhật..."
        apt-get update
        echo ">> Đang cài bản cập nhật (giống chế độ tự động)..."
        unattended-upgrade -v
        dpkg-query -W -f='Xong. Tre hiện là phiên bản ${Version}\n' tre-he-thong
        ;;
    trang-thai)
        if [[ -e "$TAT" ]]; then echo "Khôi phục: TẮT"; else echo "Khôi phục: BẬT"; fi
        if [[ -e "$TAT_TU_DANG_NHAP" ]]; then echo "Tự đăng nhập: TẮT"; else echo "Tự đăng nhập: BẬT"; fi
        ;;
    tat)
        mkdir -p "$(dirname "$TAT")"
        touch "$TAT"
        echo "Đã TẮT khôi phục. Thay đổi của tài khoản học sinh sẽ được giữ lại."
        ;;
    bat)
        rm -f "$TAT"
        echo "Đã BẬT khôi phục. Lần khởi động sau tài khoản học sinh sẽ trở về bản mẫu."
        ;;
    luu-mau)
        if [[ ! -d "$NHA_HS" ]]; then
            echo "Không thấy thư mục $NHA_HS"; exit 1
        fi
        mkdir -p "$MAU"
        rsync -a --delete --exclude "/$GIU_LAI/" \
              --exclude "/.cache/" --exclude "/.local/share/Trash/" \
              "$NHA_HS/" "$MAU/"
        mkdir -p "$MAU/$GIU_LAI"
        echo "Đã lưu bản mẫu mới từ tài khoản $TEN_HS."
        ;;
    xoa-bai)
        read -r -p "Xoá TOÀN BỘ bài trong $NHA_HS/$GIU_LAI? (c/k) " tl
        if [[ "$tl" == "c" ]]; then
            find "$NHA_HS/$GIU_LAI" -mindepth 1 -delete
            echo "Đã xoá."
        fi
        ;;
    tu-dang-nhap)
        mkdir -p /etc/tre
        case "${2:-}" in
            bat) rm -f "$TAT_TU_DANG_NHAP" ;;
            tat) touch "$TAT_TU_DANG_NHAP" ;;
            *)   echo "Dùng: sudo tre-quan-ly tu-dang-nhap bat|tat"; exit 1 ;;
        esac
        /usr/share/tre/ap-dung-tu-dang-nhap
        echo "Xong. Có hiệu lực từ lần khởi động sau."
        ;;
    *)
        huong_dan
        ;;
esac
