<?xml version="1.0" encoding="UTF-8"?>
<!--
  Tre Văn phòng: cấu hình mặc định cho LibreOffice trên Tre
  - Giao diện dạng thẻ (Tabbed) giống Ribbon, biểu tượng Colibre
  - Lưu mặc định .docx / .xlsx / .pptx, không hỏi lại định dạng
  - Phông mặc định Times New Roman 14 (máy hiển thị bằng phông Liberation Serif cùng kích thước)
  Người dùng vẫn tự đổi được trong Công cụ > Tuỳ chọn.
-->
<oor:data xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:oor="http://openoffice.org/2001/registry">
<dependency file="main"/>
<dependency file="writer"/>
<dependency file="calc"/>
<dependency file="impress"/>
<oor:component-data oor:name="Setup" oor:package="org.openoffice">
 <node oor:name="Office">
  <node oor:name="Factories">
   <node oor:name="com.sun.star.text.TextDocument">
    <prop oor:name="ooSetupFactoryDefaultFilter" oor:op="fuse"><value>MS Word 2007 XML</value></prop>
   </node>
   <node oor:name="com.sun.star.sheet.SpreadsheetDocument">
    <prop oor:name="ooSetupFactoryDefaultFilter" oor:op="fuse"><value>Calc MS Excel 2007 XML</value></prop>
   </node>
   <node oor:name="com.sun.star.presentation.PresentationDocument">
    <prop oor:name="ooSetupFactoryDefaultFilter" oor:op="fuse"><value>Impress MS PowerPoint 2007 XML</value></prop>
   </node>
  </node>
 </node>
</oor:component-data>
<oor:component-data oor:name="Common" oor:package="org.openoffice.Office">
 <node oor:name="Save">
  <node oor:name="Document">
   <prop oor:name="WarnAlienFormat" oor:op="fuse"><value>false</value></prop>
  </node>
 </node>
 <node oor:name="Misc">
  <prop oor:name="SymbolStyle" oor:op="fuse"><value>colibre</value></prop>
  <prop oor:name="ShowTipOfTheDay" oor:op="fuse"><value>false</value></prop>
 </node>
</oor:component-data>
<oor:component-data oor:name="ToolbarMode" oor:package="org.openoffice.Office.UI">
 <node oor:name="Applications">
  <node oor:name="Writer"><prop oor:name="Active" oor:op="fuse"><value>notebookbar.ui</value></prop></node>
  <node oor:name="Calc"><prop oor:name="Active" oor:op="fuse"><value>notebookbar.ui</value></prop></node>
  <node oor:name="Impress"><prop oor:name="Active" oor:op="fuse"><value>notebookbar.ui</value></prop></node>
 </node>
</oor:component-data>
<oor:component-data oor:name="Writer" oor:package="org.openoffice.Office">
 <node oor:name="DefaultFont">
  <prop oor:name="Standard" oor:op="fuse"><value>Times New Roman</value></prop>
  <prop oor:name="StandardHeight" oor:op="fuse"><value>494</value></prop>
 </node>
</oor:component-data>
</oor:data>
