#!/bin/sh
# Tre: dựng lại bộ khởi động tạm (initramfs) SAU KHI đã cài đủ phần mềm,
# bảo đảm có phần chạy Live (scripts/live). Thiếu phần này máy dừng ở "/init: .:".
set -e
update-initramfs -u -k all
for f in /boot/initrd.img-*; do
    if ! lsinitramfs "$f" | grep -Eq '(^|/)scripts/live$'; then
        echo "LOI: $f thieu scripts/live (live-boot)"; exit 1
    fi
    echo "OK: $f co du phan chay Live"
done
